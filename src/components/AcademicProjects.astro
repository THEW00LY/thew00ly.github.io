---
// src/components/AcademicProjects.astro

interface Project {
  title: string;
  category: string;
  description: string;
  challenge: string;
  tags: string[];
  repoUrl: string;
  type: "Projet Académique" | "Expérience Pro";
}

const projects: Project[] = [
  {
    title: "Exploration de Jeux par IA",
    category: "Rust & Théorie des Jeux",
    description: "Implémentation d'algorithmes de recherche décisionnelle pour environnements déterministes, stochastiques et adversariaux.",
    challenge: "Résolution Minimax avec élagage Alpha-Bêta (Dames), recherche heuristique A* (Taquin) et Expectimax (2048) avec optimisation mémoire sans ramasse-miettes.",
    tags: ["Rust", "Minimax / Alpha-Bêta", "A*", "Expectimax", "Théorie des jeux"],
    repoUrl: "https://github.com/THEW00LY/TP-IA-RUST",
    type: "Projet Académique"
  },
  {
    title: "Messagerie Concurrente Distribuée (ChatSystem)",
    category: "Systèmes Distribués & Réseaux",
    description: "Serveur d'échange en temps réel multi-clients avec gestion des flux asynchrones et tolérance aux défaillances réseau.",
    challenge: "Synchronisation mémoire des états partagés, gestion fine de la concurrence multithread et communication bas niveau par sockets TCP/IP.",
    tags: ["Java", "Sockets TCP/IP", "Multithreading", "Réseaux", "Linux"],
    repoUrl: "https://github.com/insa-4ir-chatsystem/chatsystem-2526-c1-hajji-vaccaro", // Remplace par le lien direct du repo si disponible
    type: "Projet Académique"
  },
  {
    title: "Intégration & Requêtage de Données Sémantiques",
    category: "Data Engineering & Web Sémantique",
    description: "Harmonisation, alignement ontologique de graphes RDF hétérogènes (Projet ANR Solidamin) et mise à disposition d'une interface visuelle de requêtage.",
    challenge: "Alignement ontologique (OWL, OntoME), requêtage complexe SPARQL via GraphDB et développement d'un micro-proxy Python gérant l'interopérabilité et les politiques CORS.",
    tags: ["GraphDB", "SPARQL", "RDF / OWL", "Python", "OntoME", "Docker"],
    repoUrl: "https://github.com/THEW00LY/Sparnatural-Solidamin", // Remplace par le lien direct ou vers le profil
    type: "Expérience Pro"
  }
];
---

<section id="academic-projects" class="projects-section">
  <div class="section-header">
    <span class="badge-sub">Projets Académiques & Open Source</span>
    <h2>Travaux & Ingénierie</h2>
    <p>Une sélection de défis techniques réalisés durant mon cursus universitaire.</p>
  </div>

  <div class="projects-grid">
    {projects.map((p) => (
      <article class="project-card">
        <div class="card-header">
          <span class="card-category">{p.category}</span>
          <a href={p.repoUrl} target="_blank" rel="noopener noreferrer" class="repo-link" aria-label="Voir le code">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
        </div>

        <div>
            <span class={`type-badge ${p.type === "Expérience Pro" ? "badge-pro" : "badge-academic"}`}>
                {p.type}
            </span>
        </div>

        <h3 class="card-title">{p.title}</h3>
        <p class="card-desc">{p.description}</p>

        <div class="card-challenge">
          <strong>Défi clé :</strong> {p.challenge}
        </div>

        <div class="card-tags">
          {p.tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects-section {
    padding: 4rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .badge-sub {
    font-size: 0.85rem;
    color: #818cf8;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .section-header h2 {
    font-size: 2.25rem;
    color: #ffffff;
    margin: 0.5rem 0;
  }

  .section-header p {
    color: #94a3b8;
    margin: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .project-card {
    background: #111827;
    border: 1px solid #1f2937;
    border-radius: 12px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: #374151;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .card-category {
    font-size: 0.75rem;
    color: #9ca3af;
    background: #1f2937;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .repo-link {
    color: #9ca3af;
    transition: color 0.2s ease;
  }

  .repo-link:hover {
    color: #ffffff;
  }

  .card-title {
    font-size: 1.25rem;
    color: #f3f4f6;
    margin: 0 0 0.75rem 0;
  }

  .card-desc {
    font-size: 0.925rem;
    color: #9ca3af;
    line-height: 1.5;
    margin: 0 0 1.25rem 0;
  }

  .card-challenge {
    font-size: 0.85rem;
    color: #d1d5db;
    background: rgba(31, 41, 55, 0.6);
    border-left: 3px solid #6366f1;
    padding: 0.5rem 0.75rem;
    border-radius: 0 4px 4px 0;
    margin-bottom: 1.5rem;
    margin-top: auto;
  }

  .card-challenge strong {
    color: #818cf8;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    background: #1f2937;
    color: #e5e7eb;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  /* Base commune pour tous les badges de type */
    .type-badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.2rem 0.6rem;
        border-radius: 9999px; /* Forme de pilule */
        margin-bottom: 0.75rem;
    }

    /* Style spécifique pour Expérience Pro (Teinte Émeraude / Vert technique) */
    .badge-pro {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.35);
    }

    /* Style spécifique pour Projet Académique (Teinte Indigo / Violet) */
    .badge-academic {
        background: rgba(99, 102, 241, 0.15);
        color: #a5b4fc;
        border: 1px solid rgba(99, 102, 241, 0.35);
    }

</style>