---
// src/components/Navbar.astro
interface Props {
  logoText?: string;
  githubUrl?: string;
  linkedinUrl?: string;
}

const {
  logoText = "thew00ly",
  githubUrl = "https://github.com/thew00ly",
  linkedinUrl = "https://linkedin.com/in/ton-profil"
} = Astro.props;

const navLinks = [
  { label: "SaaS", href: "#saas-showcase" },
  { label: "Projets", href: "#academic-projects" },
  { label: "Parcours", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<header class="navbar-wrapper">
  <nav class="navbar" aria-label="Navigation principale">
    <!-- Logo / Identifiant -->
    <a href="#" class="logo">
      <span class="logo-accent">&lt;</span>{logoText}<span class="logo-accent"> /&gt;</span>
    </a>

    <!-- Liens pour Desktop -->
    <ul class="nav-links desktop-menu">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link">{link.label}</a>
        </li>
      ))}
    </ul>

    <!-- Actions & Réseaux (Desktop) -->
    <div class="nav-actions desktop-menu">
      <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Profil GitHub">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Profil LinkedIn">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>
    </div>

    <!-- Bouton Burger (Mobile) -->
    <button class="burger-btn" id="mobile-toggle" aria-label="Ouvrir le menu" aria-expanded="false">
      <span class="burger-bar"></span>
      <span class="burger-bar"></span>
    </button>
  </nav>

  <!-- Tiroir Mobile -->
  <div class="mobile-drawer" id="mobile-drawer">
    <ul class="mobile-links">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="mobile-link">{link.label}</a>
        </li>
      ))}
    </ul>
    <div class="mobile-socials">
      <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn-social">
        GitHub
      </a>
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn-social">
        LinkedIn
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  // Ouvre / ferme le menu mobile
  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    toggleBtn.classList.toggle('open');
    drawer?.classList.toggle('open');
  });

  // Ferme automatiquement le tiroir au clic sur un lien d'ancre
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      toggleBtn?.setAttribute('aria-expanded', 'false');
      toggleBtn?.classList.remove('open');
      drawer?.classList.remove('open');
    });
  });
</script>

<style>
  /* Conteneur fixe */
  .navbar-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(11, 15, 25, 0.75);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .navbar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .logo {
    font-size: 1.15rem;
    font-weight: 700;
    font-family: monospace;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: opacity 0.2s ease;
  }

  .logo:hover {
    opacity: 0.85;
  }

  .logo-accent {
    color: #818cf8;
  }

  /* Menu Desktop */
  .desktop-menu {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-menu {
      display: flex;
    }
  }

  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.925rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  /* Actions & Icônes */
  .nav-actions {
    align-items: center;
    gap: 0.75rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .icon-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Bouton Burger Mobile */
  .burger-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 38px;
    height: 38px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  @media (min-width: 768px) {
    .burger-btn {
      display: none;
    }
  }

  .burger-bar {
    width: 100%;
    height: 2px;
    background-color: #f8fafc;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .burger-btn.open .burger-bar:nth-child(1) {
    transform: translateY(4px) rotate(45deg);
  }

  .burger-btn.open .burger-bar:nth-child(2) {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Tiroir Mobile */
  .mobile-drawer {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: rgba(15, 23, 42, 0.98);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem;
    box-sizing: border-box;
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition: all 0.25s ease;
  }

  .mobile-drawer