---
// src/components/ResumeTimeline.astro

interface TimelineItem {
  period: string;
  title: string;
  organization: string;
  description: string;
  skills: string[];
}

const experiences: TimelineItem[] = [
  {
    period: "2024 — Présent",
    title: "Développeur Full-Stack (Projet SaaS)",
    organization: "FreelancePulse",
    description: "Architecture et développement complet d'une solution de gestion client. Déploiement automatisé avec CI/CD et surveillance serveur.",
    skills: ["React", "Node.js", "Docker", "PostgreSQL"]
  },
  {
    period: "2023 — 2024",
    title: "Licence / Master Informatique",
    organization: "Université / École",
    description: "Spécialisation en génie logiciel, systèmes distribués, sécurité et conception d'architectures orientées services.",
    skills: ["Algorithmique", "Réseaux", "Bases de données", "Linux"]
  }
];
---

<section id="experience" class="timeline-section">
  <div class="section-header">
    <span class="badge-sub">Parcours & Expérience</span>
    <h2>CV & Formation</h2>
  </div>

  <div class="timeline">
    {experiences.map((item) => (
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <span class="period">{item.period}</span>
          <h3 class="title">{item.title}</h3>
          <span class="org">{item.organization}</span>
          <p class="desc">{item.description}</p>
          <div class="skills">
            {item.skills.map((s) => (
              <span class="skill-tag">{s}</span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .timeline-section {
    padding: 4rem 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .badge-sub {
    font-size: 0.85rem;
    color: #818cf8;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .section-header h2 {
    font-size: 2.25rem;
    color: #ffffff;
    margin: 0.5rem 0 0 0;
  }

  .timeline {
    position: relative;
    border-left: 2px solid #1f2937;
    margin-left: 1rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .timeline-item {
    position: relative;
  }

  .timeline-marker {
    position: absolute;
    left: -1.95rem;
    top: 0.35rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #6366f1;
    border: 3px solid #0b0f19;
  }

  .period {
    font-size: 0.8rem;
    color: #818cf8;
    font-weight: 600;
  }

  .title {
    font-size: 1.25rem;
    color: #ffffff;
    margin: 0.25rem 0 0.15rem 0;
  }

  .org {
    display: block;
    font-size: 0.9rem;
    color: #9ca3af;
    margin-bottom: 0.75rem;
  }

  .desc {
    font-size: 0.95rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0 0 1rem 0;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-tag {
    font-size: 0.75rem;
    background: #1e293b;
    color: #cbd5e1;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #334155;
  }
</style>