---
// src/components/Hero.astro
interface Props {
  name?: string;
  role?: string;
  bio?: string;
  cvPath?: string;
}

const {
  name = "Ton Nom",
  role = "Développeur Full-Stack & Concepteur de Solutions",
  bio = "Passionné par l'architecture logicielle et les interfaces fluides. Je conçois des applications web robustes, de la base de données jusqu'à l'expérience utilisateur.",
  cvPath = "/cv-ton-nom.pdf"
} = Astro.props;
---

<section class="hero-section">
  <div class="hero-badge">
    <span class="status-dot"></span>
    <span>Disponible pour nouveaux projets & opportunités</span>
  </div>

  <h1 class="hero-title">
    Bonjour, je suis <span class="gradient-text">{name}</span>.
  </h1>

  <p class="hero-role">{role}</p>
  <p class="hero-bio">{bio}</p>

  <div class="hero-actions">
    <a href="#saas-showcase" class="btn btn-primary">
      Explorer mes réalisations ↓
    </a>
    <a href={cvPath} download class="btn btn-secondary">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      Télécharger mon CV (PDF)
    </a>
  </div>
</section>

<style>
  .hero-section {
    padding: 6rem 1.5rem 3rem 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 9999px;
    font-size: 0.85rem;
    color: #a5b4fc;
    margin-bottom: 1.5rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6366f1;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    color: #ffffff;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.03em;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 4rem;
    }
  }

  .gradient-text {
    background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-role {
    font-size: 1.35rem;
    font-weight: 600;
    color: #cbd5e1;
    margin: 0 0 1rem 0;
  }

  .hero-bio {
    font-size: 1.1rem;
    color: #94a3b8;
    max-width: 650px;
    line-height: 1.6;
    margin: 0 0 2.25rem 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: #4f46e5;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
  }

  .btn-primary:hover {
    background: #4338ca;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
  }

  .btn-secondary:hover {
    background: #334155;
    color: #ffffff;
    transform: translateY(-2px);
  }
</style>